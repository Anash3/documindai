# Application Configuration
APP_NAME=DocuMind AI
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production-32bytes-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL or SQLite)
# PostgreSQL (Default for Docker / Production)
DATABASE_URL=postgresql://documind:documind_pass@localhost:5432/documind_db

# SQLite (Alternative for light local development without Postgres)
# DATABASE_URL=sqlite:///./documind.db

# Storage Configuration
STORAGE_DIR=./storage/uploads
VECTOR_STORE_DIR=./storage/vectors

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
